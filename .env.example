# ==========================================================
#  Variáveis de ambiente do BACKEND FisioVida
#  O frontend está em repositório separado — as variáveis dele ficam lá.
#  Copie para `.env` na raiz e ajuste os valores ao seu ambiente.
#  O `.env` é lido pelo Docker Compose: o Spring Boot NÃO lê
#  arquivos `.env` (exporte as variáveis no shell ou na IDE).
#  NUNCA versione credenciais reais.
# ==========================================================

# ---- PostgreSQL (usado pelo serviço `db` do docker-compose.yml) ----
POSTGRES_DB=fisioterapia
POSTGRES_USER=fisioterapia
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ---- Banco de dados (usado pelo backend Spring Boot) ----
# ATENÇÃO: mantenha coerência com os POSTGRES_* acima (são conjuntos independentes).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fisioterapia
DATABASE_USERNAME=fisioterapia
DATABASE_PASSWORD=change-me

# ---- Servidor ----
SERVER_PORT=8080

# ---- JWT / sessões ----
# JWT_SECRET: mínimo de 32 caracteres (exigência do HS256). Use um valor longo e aleatório.
JWT_SECRET=change-me-to-a-long-random-secret-with-at-least-32-chars
# Formato ISO-8601 Duration (NÃO é segundos): PT15M = 15 minutos, P30D = 30 dias
JWT_ACCESS_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P30D

# ---- CORS / cookie de refresh ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
# use true somente quando a API for servida por HTTPS
COOKIE_SECURE=false

# ---- Bootstrap do ADMIN (somente desenvolvimento local) ----
# Se a senha tiver menos de 8 caracteres, o ADMIN inicial NÃO é criado.
BOOTSTRAP_ADMIN_EMAIL=admin@fisiovida.local
BOOTSTRAP_ADMIN_PASSWORD=change-me

# ---- Testes de integração (opcional: dispensa o Testcontainers) ----
# TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/fisioterapia
# TEST_DATABASE_USER=fisioterapia
# TEST_DATABASE_PASSWORD=change-me

# (As variáveis do frontend ficam no repositório do frontend.)