# ==========================================================
#  Copie este archivo a `.env` (raiz del proyecto) y ajuste
#  los valores para su entorno local. JAMÁS suba `.env`.
# ==========================================================

# ---- PostgreSQL (docker-compose) ----
POSTGRES_DB=fisioterapia
POSTGRES_USER=fisioterapia
POSTGRES_PASSWORD=change-this-local-dev-password
POSTGRES_PORT=5432

# ---- Backend (Spring Boot) ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fisioterapia
DATABASE_USERNAME=fisioterapia
DATABASE_PASSWORD=change-this-local-dev-password

# Secreto JWT: use una cadena larga y aleatoria en cualquier entorno que no sea local
JWT_SECRET=change-me-en-produccion-utilice-una-cadena-larga-y-aleatoria
JWT_ACCESS_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P30D
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Usuario administrador inicial (bootstrap) - SOLO desarrollo local
BOOTSTRAP_ADMIN_EMAIL=admin@clinica.local
BOOTSTRAP_ADMIN_PASSWORD=Admin123!

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=/api